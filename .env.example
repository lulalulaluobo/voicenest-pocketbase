# VoiceNest 后端环境变量示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 加密主密钥：必须是 32 字节随机字符串
# 生成方法（任选其一）：
#   openssl rand -base64 24 | head -c 32
#   openssl rand -hex 16 | head -c 32
#   python -c "import secrets; print(secrets.token_urlsafe(24)[:32])"
#
# 安全须知：
#   - 缺失或长度不为 32 时，PocketBase 启动后 wechat hook 会拒绝加解密并抛错
#   - 一旦设置，更换密钥将导致历史已加密的微信 AppSecret 无法解密（需重新配置微信凭据）
#   - 切勿提交到 Git、写入日志或前端环境变量
VN_ENCRYPTION_KEY=

# 要部署的 Docker Hub 镜像；生产环境请固定为不可变版本标签，不要使用 latest。
VOICENEST_IMAGE=lulalulaluobo/voicenest:your-release-tag

# 仅同机反向代理时保持 127.0.0.1；跨 VPS 反向代理时设为 0.0.0.0，并用防火墙仅允许代理服务器访问 8090。
PB_BIND_ADDRESS=127.0.0.1

# 仅在首次创建 pb_data 时使用；之后修改此值不会重置已有管理员密码。
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
