{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voicenest-wechat-draft",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "WECHAT_CACHE"
    }
  ],
  "secrets": {
    "required": [
      "WECHAT_APP_ID",
      "WECHAT_APP_SECRET",
      "WECHAT_COVER_MEDIA_ID",
      "ALLOWED_ORIGINS"
    ]
  }
}
