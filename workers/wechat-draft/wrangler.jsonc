{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voicenest-wechat-draft",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "routes": [
    { "pattern": "wechat-api.lucc.fun", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "WECHAT_CACHE",
      "id": "185d1e57b556475a8efebb3f29829938"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://obvoice.lucc.fun,https://localhost"
  }
}
